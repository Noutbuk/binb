{
  "name": "binb",
  "version": "1.2.0",
  "description": "Competitive, multiplayer, realtime, guess the song game",
  "homepage": "https://binb.jpautz.de",
  "bugs": "https://github.com/noutbuk/binb/issues",
  "repository": "noutbuk/binb",
  "author": "Luigi Pinca",
  "license": "MIT",
  "scripts": {
    "minify": "for f in $(ls public/js/* | grep -v '\\.min\\.js$'); do uglifyjs $f -cm -o ${f%.js}.min.js; done",
    "import-data": "node util/load_with_complex_config.js",
    "start": "node app.js",
    "dev": "NODE_ENV=development node app.js",
    "admin:setup": "node scripts/setup-admin.js setup",
    "admin:list": "node scripts/setup-admin.js list",
    "admin:promote": "node scripts/setup-admin.js promote",
    "local:redis": "docker compose -f docker-compose.local.yml up -d",
    "local:redis-stop": "docker compose -f docker-compose.local.yml down",
    "local:redis-logs": "docker compose -f docker-compose.local.yml logs -f",
    "local:start": "NODE_ENV=development node --env-file=.env.local app.js",
    "docker:build": "docker build -t binb:latest .",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker compose up --build -d",
    "docker:stop": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:validate": "bash scripts/validate-docker.sh",
    "test:server": "NODE_ENV=test node --env-file=.env.local app.js",
    "test:redis": "docker compose -f docker-compose.test.yml up",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:debug": "npx playwright test --debug",
    "test:unit": "jest",
    "test:cleanup": "npm run local:redis-stop",
    "test:full": "npm run test:e2e"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@sendgrid/mail": "^7.3.0",
    "async": "^3.1.1",
    "body-parser": "^1.18.3",
    "canvas": "^2.11.2",
    "connect-redis": "^5.1.0",
    "cookie-parser": "^1.4.4",
    "dotenv": "^16.0.3",
    "express": "^4.16.4",
    "express-session": "^1.16.1",
    "forwarded-for": "^1.0.1",
    "jsdom": "^22.0.0",
    "JSONStream": "^1.3.5",
    "limiter": "^2.1.0",
    "primus": "^8.0.1",
    "primus-emitter": "^3.1.1",
    "primus-rooms": "^3.4.1",
    "pug": "^3.0.2",
    "redis": "^4.6.6",
    "serve-favicon": "^2.5.0",
    "uglify-js": "^3.5.4",
    "ws": "^7.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "jest": "^30.1.3",
    "jest-junit": "^16.0.0",
    "prettier": "^2.8.8"
  }
}
