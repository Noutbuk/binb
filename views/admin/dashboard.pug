extends layout

block title
  title Admin Dashboard - binb

block sections
  .hero-unit
    h1 Admin Dashboard
    p Welcome to the binb administration panel
  
  .row
    .span4
      .well
        h3 #{totalRooms}
        p Total Rooms
        a.btn.btn-primary(href="/admin/rooms") Manage Rooms
    
    .span4
      .well
        h3 #{totalSongs}
        p Total Songs
        a.btn.btn-info(href="/admin/rooms") View Details
    
    .span4
      .well
        h3 #{activeRooms}
        p Active Rooms
        button.btn.btn-success#quick-import Quick Import
  
  .row
    .span12
      h2 Recent Rooms
      if rooms && rooms.length > 0
        table.table.table-striped
          thead
            tr
              th Room Name
              th Description
              th Songs
              th Status
              th Last Updated
              th Actions
          tbody
            each room in rooms.slice(0, 10)
              tr
                td
                  a(href=`/admin/rooms/${room.name}`) #{room.name}
                td #{room.description || 'No description'}
                td #{room.songCount}
                td
                  if room.active
                    span.label.label-success Active
                  else
                    span.label.label-warning Inactive
                td #{new Date(room.updatedAt).toLocaleDateString()}
                td
                  a.btn.btn-mini.btn-primary(href=`/admin/rooms/${room.name}`) Manage
      else
        .alert.alert-info
          strong No rooms found.
          | Get started by creating your first room.
  
  .row
    .span12
      .well
        h3 Quick Actions
        .btn-group
          button.btn.btn-large.btn-primary#create-room-btn Create New Room
          button.btn.btn-large.btn-info#import-playlist-btn Import Playlist
          button.btn.btn-large.btn-warning#search-songs-btn Search Songs

  // Modals
  #createRoomModal.modal.hide.fade
    .modal-header
      button.close(type="button", data-dismiss="modal") ×
      h3 Create New Room
    .modal-body
      form#createRoomForm
        .control-group
          label.control-label(for="roomName") Room Name
          .controls
            input#roomName(type="text", name="name", required, pattern="[a-zA-Z0-9-_]+", title="Only letters, numbers, hyphens and underscores allowed")
        .control-group
          label.control-label(for="roomDescription") Description
          .controls
            textarea#roomDescription(name="description", rows="3")
        .control-group
          label.control-label Active
            input(type="checkbox", name="active", checked)
    .modal-footer
      button.btn(data-dismiss="modal") Cancel
      button.btn.btn-primary#createRoomSubmit(type="submit") Create Room
