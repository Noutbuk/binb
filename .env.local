# Local development environment variables
# Redis connection (Docker container)
REDIS_URL=redis://localhost:6379

# Server configuration
PORT=8138
NODE_ENV=development

# Session configuration
SITE_SECRET=local-dev-secret-change-in-production

# Optional: Email configuration (leave blank for local dev)
SENDGRID_API_KEY=
EMAIL_FROM=

# Optional: Other configuration
REDIS_FAMILY=IPv4
